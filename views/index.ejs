<!DOCTYPE html>
<html lang="<%= getLocale() %>">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bgBase: '#fdfbf7', // Màu kem nền nã hơn
                        main: '#544A47', 
                        accent: '#BA2636',
                        gold: '#C5A059' // Thêm màu vàng sang trọng
                    },
                    fontFamily: {
                        serif: ['Georgia', 'serif'] // Font chữ có chân cho tiêu đề
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-bgBase text-main font-sans antialiased selection:bg-accent selection:text-white">


    <header id="main-header" class="fixed top-0 w-full z-50 transition-transform duration-300 shadow-md">
        
        <div class="bg-main text-white py-2 px-5 text-[11px] md:text-xs font-medium tracking-wide border-b border-white/10">
            <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
                
                <div class="flex items-center gap-4 md:gap-6">
                    <div class="flex items-center gap-2 opacity-90">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 md:h-4 md:w-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span><%= __('header_opening_hours') %></span>
                    </div>
                    <a href="tel:0901234567" class="flex items-center gap-2 hover:text-gold transition group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 md:h-4 md:w-4 text-gold group-hover:animate-bounce" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                        </svg>
                        <span class="underline decoration-gold decoration-1 underline-offset-2">090-1234-5678</span>
                    </a>
                </div>

                <div class="flex items-center gap-3">
                    <span class="hidden md:inline text-white/50">Language:</span>
                    <div class="flex items-center gap-3 text-white/80">
                        <% const activeClass = "font-bold text-gold scale-110"; %>
                        <% const normalClass = "hover:text-white transition hover:scale-110 opacity-70 hover:opacity-100"; %>
                        <a href="/change-lang/vi" class="flex items-center gap-1 <%= getLocale() === 'vi' ? activeClass : normalClass %>">
                            <img src="https://flagcdn.com/w20/vn.png" class="w-4 h-auto shadow-sm" alt="VN"> VI
                        </a>
                        <span class="text-white/20">|</span>
                        
                        <a href="/change-lang/jp" class="flex items-center gap-1 <%= getLocale() === 'jp' ? activeClass : normalClass %>">
                            <img src="https://flagcdn.com/w20/jp.png" class="w-4 h-auto shadow-sm" alt="JP"> JP
                        </a>
                        <span class="text-white/20">|</span>

                        <a href="/change-lang/zh" class="flex items-center gap-1 <%= getLocale() === 'zh' ? activeClass : normalClass %>">
                            <img src="https://flagcdn.com/w20/cn.png" class="w-4 h-auto shadow-sm" alt="ZH"> ZH
                        </a>
                        <span class="text-white/20">|</span>

                        <a href="/change-lang/en" class="flex items-center gap-1 <%= getLocale() === 'en' ? activeClass : normalClass %>">
                            <img src="https://flagcdn.com/w20/us.png" class="w-4 h-auto shadow-sm" alt="EN"> EN
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white/95 backdrop-blur-md">
            <div class="max-w-7xl mx-auto px-5 h-[70px] md:h-[80px] flex items-center justify-between">
                
                <a href="/" class="w-[120px] md:w-[140px] hover:opacity-80 transition">
                    <img src="https://static.kyotokimonorental.com/app/img/common/logo.svg" alt="Logo">
                </a>

                <div class="flex items-center gap-4 md:gap-6">
                    <a href="https://facebook.com" target="_blank" class="text-gray-400 hover:text-[#1877F2] transition transform hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                    </a>

                    <a href="https://tiktok.com" target="_blank" class="text-gray-400 hover:text-black transition transform hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                    </a>

                    <a href="/booking-step1" class="hidden md:flex bg-accent text-white px-6 py-2.5 rounded-full font-bold shadow-lg hover:bg-red-700 transition items-center gap-2">
                        <span>📅</span>
                        <span><%= __('header_book_now') %></span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <div class="relative w-full h-screen md:h-[100dvh]">
        
        <div class="swiper mySwiper w-full h-full">
            <div class="swiper-wrapper">
                <% if (typeof heroImages !== 'undefined' && heroImages && heroImages.length > 0) { %>
                    
                    <% heroImages.forEach(img => { %>
                        <div class="swiper-slide relative">
                            <img src="<%= img %>" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-black/40"></div>
                        </div>
                    <% }) %>

                <% } else { %>
                    <div class="swiper-slide relative">
                        <img src="https://static.kyotokimonorental.com/app/img/top/hero/autumn/vi/sp/hero01.webp" 
                             class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-black/40"></div>
                    </div>
                <% } %>
            </div>
            <div class="swiper-pagination"></div>
        </div>

        <div class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none">
            <div class="text-center text-white p-5 animate-fade-in-up pointer-events-auto">
                <span class="block text-gold font-serif text-xl mb-4 italic tracking-wider drop-shadow-md"><%= __('hero.tagline') %></span>
                <h1 class="text-4xl md:text-7xl font-bold font-serif leading-tight mb-6 drop-shadow-lg">
                    <%= __('hero.title_line1') %> <br> <%= __('hero.title_line2') %>
                </h1>
                
                <div class="flex justify-center gap-4 mb-8 text-sm md:text-base font-medium">
                    <span class="bg-white/20 backdrop-blur px-4 py-1 rounded-full border border-white/30"><%= __('hero.badge_1') %></span>
                    <span class="bg-white/20 backdrop-blur px-4 py-1 rounded-full border border-white/30"><%= __('hero.badge_2') %></span>
                </div>

                <a href="#plans" class="group relative inline-flex items-center gap-2 overflow-hidden rounded-full bg-accent px-10 py-4 font-bold text-white transition-all hover:bg-red-700 hover:ring-4 hover:ring-red-200">
                    <span><%= __('hero.cta') %></span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 transition-transform group-hover:translate-x-1">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <div id="quick-nav-placeholder" class="h-0"></div>

<div id="quick-nav" class="py-4 bg-white border-b border-gray-100 shadow-sm z-40 transition-all duration-300 w-full">
    <div class="max-w-7xl mx-auto px-5">
        <div class="grid grid-cols-4 gap-2 md:flex md:justify-center md:gap-6">
            <a href="#plans" class="nav-item group flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer">
                <span class="text-xl">👘</span>
                        <span class="text-xs md:text-sm font-bold text-gray-600 group-hover:text-accent"><%= __('quick_nav.plan') %></span>
                    </a>
            
            <a href="#gallery" class="nav-item group flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer">
                <span class="text-xl">📸</span> <span class="text-xs md:text-sm font-bold text-gray-600 group-hover:text-accent"><%= __('quick_nav.gallery') %></span>
            </a>

            <a href="#set-contents" class="nav-item group flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer">
                <span class="text-xl">🎒</span>
                <span class="text-xs md:text-sm font-bold text-gray-600 group-hover:text-accent"><%= __('quick_nav.set_contents') %></span>
            </a>

            <a href="#flow" class="nav-item group flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer">
                <span class="text-xl">🔄</span>
                <span class="text-xs md:text-sm font-bold text-gray-600 group-hover:text-accent"><%= __('quick_nav.flow') %></span>
            </a>

            <a href="#faq" class="nav-item group flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer">
                <span class="text-xl">❓</span>
                <span class="text-xs md:text-sm font-bold text-gray-600 group-hover:text-accent"><%= __('quick_nav.faq') %></span>
            </a>
        </div>
    </div>
</div>
        <section id="plans" class="py-20 px-5">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <span class="text-accent font-bold text-sm tracking-widest uppercase mb-2 block"><%= __('sections.plans.subtitle') %></span>
                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-main"><%= __('sections.plans.title') %></h2>
                    <div class="w-20 h-1 bg-gold mx-auto mt-6"></div>
                </div>

                <div class="grid md:grid-cols-3 gap-10">
                    <% plans.forEach(plan => { %>
                        <div class="group bg-white rounded-[20px] overflow-hidden shadow-[0_10px_40px_-15px_rgba(0,0,0,0.1)] hover:shadow-[0_20px_50px_-10px_rgba(0,0,0,0.2)] transition duration-500 border border-gray-100 flex flex-col">
                            
                            <div class="relative h-[320px] overflow-hidden group/slider">
                                <div class="swiper planSwiper w-full h-full">
                                    <div class="swiper-wrapper">
                                        
                                        <% if (plan.images && plan.images.length > 0) { %>
                                            <% plan.images.forEach(imgLink => { %>
                                                <div class="swiper-slide">
                                                    <img src="<%= imgLink %>" class="w-full h-full object-cover object-top transition duration-700 ease-out group-hover:scale-110" alt="<%= plan.title %>">
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="swiper-slide">
                                                <img src="<%= plan.image %>" class="w-full h-full object-cover object-top transition duration-700 ease-out group-hover:scale-110" alt="<%= plan.title %>">
                                            </div>
                                        <% } %>

                                    </div>
                                    
                                    <div class="swiper-button-next !w-8 !h-8 !bg-white/80 !rounded-full !text-main !text-xs after:!text-xs opacity-0 group-hover/slider:opacity-100 transition shadow-md"></div>
                                    <div class="swiper-button-prev !w-8 !h-8 !bg-white/80 !rounded-full !text-main !text-xs after:!text-xs opacity-0 group-hover/slider:opacity-100 transition shadow-md"></div>
                                    
                                    <div class="swiper-pagination !bottom-2"></div>
                                </div>

                                <% if(plan.tag) { %>
                                    <div class="absolute top-4 right-4 z-10 bg-white/90 backdrop-blur text-accent px-4 py-1 rounded-full text-xs font-bold shadow-sm uppercase tracking-wider">
                                        <%= plan.tag %>
                                    </div>
                                <% } %>
                            </div>
                                                        
                            <div class="p-8 flex-1 flex flex-col">
                                <h3 class="text-xl font-bold mb-2 font-serif text-gray-800"><%= plan.title %></h3>
                                <div class="flex items-baseline gap-3 mb-4">
                                    <span class="text-accent text-2xl font-bold font-serif">¥<%= plan.price.toLocaleString() %></span>
                                    <span class="text-sm line-through text-gray-400">¥<%= plan.originalPrice.toLocaleString() %></span>
                                </div>
                                <p class="text-sm text-gray-500 leading-relaxed mb-6 flex-1"><%= plan.desc %></p>
                                
                                <a href="/plan/<%= plan.id %>" class="block w-full text-center py-3 border border-main text-main rounded-full font-bold hover:bg-main hover:text-white transition duration-300">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

<section id="set-contents" class="py-16 bg-[#fdfbf7] border-t border-gray-100">
        <div class="max-w-5xl mx-auto px-5">
            <div class="text-center mb-12">
                <span class="text-accent font-bold text-sm tracking-widest uppercase mb-2 block">Chi tiết</span>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-main">Nội Dung Gói Thuê</h2>
                <p class="text-gray-500 mt-4 text-sm md:text-base">Mọi thứ bạn cần để biến hóa hoàn hảo đều đã bao gồm trong giá.</p>
                <div class="w-20 h-1 bg-gold mx-auto mt-6"></div>
            </div>

            <div class="grid md:grid-cols-2 gap-10 items-start">
                
                <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition duration-300">
                    <h3 class="text-xl font-bold text-main text-center mb-4 border-b border-gray-100 pb-3">
                        👘 Nội dung bộ Kimono
                    </h3>
                    <div class="aspect-[4/3] rounded-lg overflow-hidden mb-4 border border-gray-100">
                        <img src="https://static.kyotokimonorental.com/app/img/plan/set-contents-vi.webp" 
                             alt="Chi tiết bộ Kimono" 
                             class="w-full h-full object-contain hover:scale-105 transition duration-500">
                    </div>
                    <ul class="text-sm text-gray-600 space-y-2 pl-4 list-disc marker:text-accent">
                        <li>Kimono (Theo gói đã chọn)</li>
                        <li>Đai lưng (Obi)</li>
                        <li>Dép (Zori) & Tất (Tabi)</li>
                        <li>Túi xách Nhật Bản</li>
                        <li>Đồ lót chuyên dụng (Nagajuban, Hadajuban)</li>
                        <li>Dịch vụ mặc đồ chuyên nghiệp</li>
                    </ul>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition duration-300">
                    <h3 class="text-xl font-bold text-main text-center mb-4 border-b border-gray-100 pb-3">
                        🎐 Nội dung bộ Yukata
                    </h3>
                    <div class="aspect-[4/3] rounded-lg overflow-hidden mb-4 border border-gray-100">
                        <img src="https://static.kyotokimonorental.com/app/img/yukata/set-contents-vi.webp" 
                             alt="Chi tiết bộ Yukata" 
                             class="w-full h-full object-contain hover:scale-105 transition duration-500">
                    </div>
                    <ul class="text-sm text-gray-600 space-y-2 pl-4 list-disc marker:text-accent">
                        <li>Yukata (Mùa hè)</li>
                        <li>Đai lưng (Obi)</li>
                        <li>Guốc gỗ (Geta)</li>
                        <li>Túi dây rút</li>
                        <li>Đồ lót mỏng (Hadagi)</li>
                        <li>Dịch vụ mặc đồ chuyên nghiệp</li>
                    </ul>
                </div>

            </div>

            <div class="mt-8 text-center bg-white p-4 rounded-xl border border-dashed border-accent/30 mx-auto max-w-3xl">
                <p class="text-sm text-main font-medium">
                    <span class="text-xl mr-1">💡</span> 
                    <strong>Lưu ý:</strong> Dịch vụ làm tóc cơ bản đã bao gồm trong gói (đối với nữ). Các kiểu tóc phức tạp hoặc phụ kiện cao cấp có thể tính phí tùy chọn.
                </p>
            </div>
        </div>
    </section>

        <section id="flow" class="py-16 md:py-24 bg-[#fdfbf7]">
        <div class="max-w-7xl mx-auto px-5">
            <div class="text-center mb-16">
                <span class="text-accent font-bold text-sm tracking-widest uppercase mb-2 block">Dễ dàng & Tiện lợi</span>
                <h2 class="text-3xl md:text-4xl font-serif font-bold text-main">Quy Trình Thuê Kimono</h2>
                <div class="w-20 h-1 bg-gold mx-auto mt-6"></div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 relative hover:-translate-y-2 transition duration-300">
                    <div class="absolute -top-5 -left-5 w-12 h-12 bg-accent text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg">1</div>
                    <div class="h-16 w-16 bg-red-50 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">📅</div>
                    <h3 class="text-xl font-bold text-center mb-3">Đặt Chỗ & Đến Tiệm</h3>
                    <p class="text-gray-500 text-sm text-center leading-relaxed">Đặt lịch trước qua web để giữ chỗ. Đến tiệm tay không, không cần mang theo gì cả!</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 relative hover:-translate-y-2 transition duration-300">
                    <div class="absolute -top-5 -left-5 w-12 h-12 bg-accent text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg">2</div>
                    <div class="h-16 w-16 bg-red-50 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">👘</div>
                    <h3 class="text-xl font-bold text-center mb-3">Chọn & Mặc Kimono</h3>
                    <p class="text-gray-500 text-sm text-center leading-relaxed">Chọn bộ Kimono ưng ý từ nhiều mẫu. Chuyên gia sẽ giúp bạn mặc đẹp chuẩn Nhật Bản (khoảng 20p).</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 relative hover:-translate-y-2 transition duration-300">
                    <div class="absolute -top-5 -left-5 w-12 h-12 bg-accent text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg">3</div>
                    <div class="h-16 w-16 bg-red-50 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">💄</div>
                    <h3 class="text-xl font-bold text-center mb-3">Làm Tóc & Phụ Kiện</h3>
                    <p class="text-gray-500 text-sm text-center leading-relaxed">Tạo kiểu tóc chuyên nghiệp miễn phí/trả phí. Chọn túi xách, guốc gỗ (Geta) phù hợp.</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 relative hover:-translate-y-2 transition duration-300">
                    <div class="absolute -top-5 -left-5 w-12 h-12 bg-accent text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg">4</div>
                    <div class="h-16 w-16 bg-red-50 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">📸</div>
                    <h3 class="text-xl font-bold text-center mb-3">Dạo Phố & Chụp Ảnh</h3>
                    <p class="text-gray-500 text-sm text-center leading-relaxed">Tự do khám phá phố cổ, chụp những bức ảnh để đời. Gửi hành lý lại tiệm an toàn.</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 relative hover:-translate-y-2 transition duration-300">
                    <div class="absolute -top-5 -left-5 w-12 h-12 bg-accent text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg">5</div>
                    <div class="h-16 w-16 bg-red-50 rounded-full flex items-center justify-center mb-4 mx-auto text-3xl">↩️</div>
                    <h3 class="text-xl font-bold text-center mb-3">Trả Đồ</h3>
                    <p class="text-gray-500 text-sm text-center leading-relaxed">Quay lại tiệm trả đồ trước giờ đóng cửa (hoặc chọn gói trả vào ngày hôm sau/trả tại khách sạn).</p>
                </div>

                <div class="bg-gradient-to-br from-accent to-red-800 p-8 rounded-2xl shadow-lg flex flex-col justify-center items-center text-white text-center transform scale-105">
                    <h3 class="text-2xl font-bold mb-2">Sẵn sàng chưa?</h3>
                    <p class="text-white/80 mb-6 text-sm">Đặt lịch ngay để nhận ưu đãi giảm giá online!</p>
                    <a href="/booking-step1" class="bg-white text-accent px-8 py-3 rounded-full font-bold shadow-md hover:bg-gray-100 transition w-full">ĐẶT LỊCH NGAY</a>
                </div>
            </div>
        </div>
    </section>
    <section id="gallery" class="py-20 px-5 bg-white border-t border-gray-100">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16">
                    <span class="text-accent font-bold text-sm tracking-widest uppercase mb-2 block">Thư viện ảnh</span>
                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-main">Khách Hàng Của Chúng Tôi</h2>
                    
                    <a href="https://instagram.com/wargo_kimono" target="_blank" class="inline-flex items-center gap-2 mt-3 text-gray-500 hover:text-accent transition group">
                        <img src="https://static.kyotokimonorental.com/app/img/icon/icon-instagram.webp" class="w-6 h-6 grayscale group-hover:grayscale-0 transition">
